# ─── Supabase (database + optional Auth from frontend) ────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Gemini (Google AI Studio — recommended) ───────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Model id (fast default).
GEMINI_MODEL=gemini-2.0-flash

# HTTP timeout for each Gemini request (milliseconds). Prevents multi-minute hangs.
GEMINI_REQUEST_TIMEOUT_MS=120000

# Cap on generated tokens (lower = usually faster for JSON plans).
GEMINI_MAX_OUTPUT_TOKENS=4096

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
REPORT_CUTOFF_HOUR=18

# ─── Resend ───────────────────────────────────────────────────────────────────
# Do NOT put Resend here for auth emails. Configure custom SMTP in Supabase:
#   Dashboard → Project → Authentication → SMTP Settings
#   Host: smtp.resend.com  Port: 465  Username: resend  Password: <RESEND_API_KEY>
#   Sender: onboarding@yourdomain.com (verified domain in Resend)
