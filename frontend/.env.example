# Backend API (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (browser). Create project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# true = browser-only seeded users, no Supabase. false + keys above = Supabase password sign-in (default).
NEXT_PUBLIC_AUTH_LOCAL_ONLY=false

# Optional: set true when Supabase email OTP / email confirmation is working with your SMTP sender.
# NEXT_PUBLIC_SUPABASE_OTP_AUTH=true

# Optional but recommended: public site URL used for auth redirects.
# Local dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_SITE_URL=https://executionai.me
